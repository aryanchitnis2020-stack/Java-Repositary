package info.java;

import java.util.Scanner;

class StringAnalyzer {
    String str;

    StringAnalyzer(String str) {
        this.str = str;
    }

    int countVowels() {
        int count = 0;

        for (int i = 0; i < str.length(); i++) {
            char ch = Character.toLowerCase(str.charAt(i));

            if (ch == 'a' || ch == 'e' || ch == 'i' ||
                ch == 'o' || ch == 'u') {
                count++;
            }
        }

        return count;
    }

    int countConsonants() {
        int count = 0;

        for (int i = 0; i < str.length(); i++) {
            char ch = Character.toLowerCase(str.charAt(i));

            if (Character.isLetter(ch) &&
                !(ch == 'a' || ch == 'e' || ch == 'i' ||
                  ch == 'o' || ch == 'u')) {
                count++;
            }
        }

        return count;
    }

    int countDigits() {
        int count = 0;

        for (int i = 0; i < str.length(); i++) {
            if (Character.isDigit(str.charAt(i))) {
                count++;
            }
        }

        return count;
    }

    int countSpaces() {
        int count = 0;

        for (int i = 0; i < str.length(); i++) {
            if (str.charAt(i) == ' ') {
                count++;
            }
        }

        return count;
    }

    boolean isPalindrome() {
        String original = str.replaceAll("\\s+", "").toLowerCase();
        String reverse = "";

        for (int i = original.length() - 1; i >= 0; i--) {
            reverse += original.charAt(i);
        }

        return original.equals(reverse);
    }

    void display() {
        System.out.println("\n----- String Analysis -----");
        System.out.println("Number of Vowels     : " + countVowels());
        System.out.println("Number of Consonants : " + countConsonants());
        System.out.println("Number of Digits     : " + countDigits());
        System.out.println("Number of Spaces     : " + countSpaces());
        System.out.println("Palindrome           : " + isPalindrome());
    }
}

public class StringAnalyzerDemo {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a string: ");
        String str = sc.nextLine();

        StringAnalyzer obj = new StringAnalyzer(str);
        obj.display();

        sc.close();
    }
}
